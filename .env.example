# Copiar a .env y completar credenciales (no commitear .env)

# PostgreSQL (legacy local)
# DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/manizales_epic_race_2026

# SQL Server (proyecto actual)
DB_PROVIDER=sqlserver
MSSQL_SERVER=YOUR_SERVER
MSSQL_DATABASE=manizales_epic_race_2026
MSSQL_USER=YOUR_USER
MSSQL_PASSWORD=CHANGE_ME
DATABASE_URL=sqlserver://YOUR_SERVER:1433;database=manizales_epic_race_2026;user=YOUR_USER;password=CHANGE_ME;encrypt=true;trustServerCertificate=true
STORAGE_ROOT=./storage/private
SESSION_SECRET=generate-a-long-random-string
MAX_REGISTRATIONS=300
EVENT_DATE=2026-12-13
NEXT_PUBLIC_EVENT_TZ=America/Bogota

# Correo al confirmar inscripcion (todos los datos del formulario)
REGISTRATION_NOTIFY_EMAIL=jimeneztorojulian@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=contrasena_de_aplicacion_gmail
SMTP_FROM="Manizales Epic Race" <tu_cuenta@gmail.com>
